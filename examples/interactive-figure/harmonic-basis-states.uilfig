{
  "format": "uil.interactive-figure",
  "version": 1,
  "title": "A coherent packet and its real basis components",
  "background_svg": "<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 800 600'><rect width='800' height='600' fill='#f8fafc'/></svg>",
  "plot": {
    "kind": "harmonic-basis-states",
    "x_min": -5.0,
    "x_max": 5.0,
    "density_y_max": 0.65,
    "x_label": "$x = q / \\ell$",
    "density_color": "#0f766e",
    "basis_colors": ["#2563eb", "#0f766e", "#b45309", "#7c3aed", "#be185d", "#0369a1"]
  },
  "controls": {
    "phase": { "min": 0.0, "max": 1.0, "value": 0.5 },
    "initial_stretch": { "min": 0.5, "max": 4.0, "value": 3.0 },
    "period_seconds": 8.0,
    "loop": true,
    "animate": true
  }
}
