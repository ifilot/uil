{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ivofilot.nl/uil/schemas/atomic-orbital-v1.schema.json",
  "title": "UIL atomic orbital version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "version", "title", "orbital", "sampling_plane"],
  "properties": {
    "format": { "const": "uil.atomic-orbital" },
    "version": { "const": 1 },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "orbital": {
      "type": "string",
      "description": "Managlyph-style real hydrogenic orbital name from 1s through 5g."
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "isovalue": {
          "type": "number",
          "minimum": 0,
          "default": 0,
          "description": "Absolute signed-wavefunction isovalue. Zero selects the automatic 95% radial cutoff."
        },
        "positive_color": { "type": "string", "default": "#2563eb" },
        "negative_color": { "type": "string", "default": "#dc2626" },
        "grid_size": {
          "type": "integer",
          "minimum": 33,
          "maximum": 129,
          "default": 65,
          "description": "Odd number of samples along each volume dimension."
        }
      }
    },
    "sampling_plane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["xy", "xz", "yz"] },
        "offset": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max", "value"],
          "properties": {
            "min": { "type": "number", "minimum": -1, "maximum": 1 },
            "max": { "type": "number", "minimum": -1, "maximum": 1 },
            "value": { "type": "number", "minimum": -1, "maximum": 1 }
          },
          "description": "Plane offsets expressed as fractions of the sampled volume half-extent."
        }
      }
    },
    "contour": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "colormap": {
          "enum": [
            "coolwarm", "coolwarm_r", "seismic", "seismic_r", "bwr", "bwr_r",
            "RdBu", "RdBu_r", "PuOr", "PuOr_r", "BrBG", "BrBG_r",
            "PiYG", "PiYG_r", "PRGn", "PRGn_r", "RdGy", "RdGy_r",
            "garnet_teal", "garnet_teal_r", "garnet_slate", "garnet_slate_r"
          ],
          "default": "coolwarm"
        },
        "maximum": {
          "type": "number",
          "exclusiveMinimum": 1e-8,
          "maximum": 1,
          "default": 0.01,
          "description": "Absolute wavefunction magnitude at the ends of the divergent scale. UIL snaps it to the nearest power of ten; the lower cutoff is fixed at 1e-8."
        },
        "levels": { "type": "integer", "minimum": 2, "maximum": 32, "default": 12 }
      }
    }
  }
}
